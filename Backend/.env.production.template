# Production environment template for the Hostinger CPU compose stack.
# Copy to .env.production on the Hostinger VPS and fill in placeholders.
# This file is consumed by docker-compose.cpu.yml.

# ── Identity / tenant ───────────────────────────────────────
TENANT_ID=default

# ── Image registry ──────────────────────────────────────────
# GHCR namespace and tag for all airco-* images.
IMAGE_REGISTRY=ghcr.io/dscyrus07-dev
IMAGE_TAG=latest

# ── Bind addresses ──────────────────────────────────────────
# Internal services (Postgres / Redis / MinIO) bind here only.
# Set to the host's Tailscale IPv4 so the GPU pod can reach them.
# Leave as 127.0.0.1 to fully isolate (manual SSH tunnel only).
INTERNAL_BIND_IP=127.0.0.1
# Public-facing services bind to 0.0.0.0 by default so Caddy can
# proxy them.
API_BIND_IP=0.0.0.0
CENTRIFUGO_BIND_IP=0.0.0.0
GO2RTC_BIND_IP=0.0.0.0
MEDIAMTX_BIND_IP=0.0.0.0

# ── Public URLs (built into the frontend / used in presigned URLs) ─
PUBLIC_API_URL=https://api.the-airco.net
PUBLIC_WS_URL=wss://api.the-airco.net/centrifugo/connection/websocket
PUBLIC_GO2RTC_URL=https://media.the-airco.net
PUBLIC_MINIO_URL=https://api.the-airco.net/minio
MINIO_PUBLIC_PRESIGN=true

# ── Storage credentials ─────────────────────────────────────
POSTGRES_PASSWORD=__SET_ME__
MINIO_ACCESS_KEY=__SET_ME__
MINIO_SECRET_KEY=__SET_ME__
MINIO_BUCKET=airco-evidence

# ── Realtime / auth ─────────────────────────────────────────
CENTRIFUGO_API_KEY=__SET_ME__
CENTRIFUGO_TOKEN_SECRET=__SET_ME__

SESSION_SECRET=__SET_ME__
SESSION_COOKIE_NAME=airco_session
SESSION_TTL_SECONDS=604800
SESSION_SECURE_COOKIE=true
# `none` is required for cross-site cookies (Cloudflare Pages frontend
# on app.the-airco.net → API on api.the-airco.net).
SESSION_SAME_SITE=none
SESSION_COOKIE_DOMAIN=.the-airco.net

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=__SET_ME__
SUPABASE_ANON_KEY=__SET_ME__
SUPABASE_SERVICE_ROLE_KEY=__SET_ME__

# ── RunPod GPU lifecycle ────────────────────────────────────
# Used by the boot controller in services/api/api/gpu_controller.py
# to resume / stop the GPU pod on session_start / session_stop.
RUNPOD_API_KEY=__SET_ME__
RUNPOD_POD_ID=__SET_ME__
# Comma-separated list, in preference order, of acceptable GPU types
# if RunPod needs to allocate a new instance.
RUNPOD_GPU_TYPE_IDS=NVIDIA GeForce RTX 3090,NVIDIA GeForce RTX 4090
# Seconds of zero active sessions before the pod is stopped.
GPU_IDLE_TIMEOUT_SECONDS=900
# Max seconds to wait for the GPU pod to report healthy on resume
# before the session start fails.
GPU_BOOT_TIMEOUT_SECONDS=180
# HTTP(S) URL the API hits to verify the GPU pod is healthy. Usually
# the pod's Tailscale-side Triton readiness URL, e.g.
# http://airco-gpu.taila1234.ts.net:8002/v2/health/ready
GPU_HEALTH_TARGET=

# ── Tailscale ───────────────────────────────────────────────
# Used by the host-level tailscaled daemon, not by docker. Just here
# for reference / scripted setup.
TAILSCALE_AUTHKEY=__SET_ME__
