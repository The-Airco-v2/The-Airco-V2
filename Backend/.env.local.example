# ============================================================
# v2/.env.local — Local development secrets
# Copy this file to .env.local and fill in the three Supabase values.
# This file is gitignored and never committed.
# ============================================================

# ── Supabase (fill these in) ─────────────────────────────────
# From: Supabase dashboard → your project → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon/public key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ── Auth ─────────────────────────────────────────────────────
# Keep false — use real Supabase JWT locally.
# Set true only if you want to bypass login entirely (dev shortcut).
SKIP_AUTH=false

# ── Infrastructure (safe defaults for local Docker) ──────────
POSTGRES_PASSWORD=localdev
MINIO_ACCESS_KEY=airco
MINIO_SECRET_KEY=localdev
MINIO_BUCKET=airco-evidence
CENTRIFUGO_API_KEY=localdev-centrifugo-api-key-0123456789
CENTRIFUGO_TOKEN_SECRET=localdev-centrifugo-token-secret-0123456789
TENANT_ID=default

# ── Browser-facing URLs (used by frontend at build time) ─────
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8088/connection/websocket
PUBLIC_GO2RTC_URL=http://localhost:1984
