# Frontend build-time env for the Cloudflare Pages deploy.
# Copy to .env.production and adjust hosts to your deployment.
# Used by Vite at `npm run build`; values are baked into the bundle.

# Absolute origin of the FastAPI service.
VITE_API_URL=https://api.the-airco.net

# Absolute WebSocket URL for the Centrifugo gateway.
VITE_WS_URL=wss://api.the-airco.net/centrifugo/connection/websocket

# Origin of the go2rtc WebRTC frontend (stream.html). Leave empty in
# dev so the Vite proxy at /webrtc handles it.
VITE_GO2RTC_URL=https://media.the-airco.net
